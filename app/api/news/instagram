import { getCloudflareContext } from "@opennextjs/cloudflare";

export const dynamic = "force-dynamic";

const TZ = "Asia/Tehran";
const MAX_SEEN = 1000;

type Account = "modiryar_com" | "hr_garden";

type MediaPost = {
  id: string;
  timestamp: number;
  caption: string;
  media: Array<{ url: string; video: boolean }>;
};

type AccountState = {
  version: 1;
  seen: string[];
  queue: MediaPost[];
  sentSlots: string[];
};

type Env = {
  NEXT_PUBLIC_SUPABASE_URL?: string;
  SUPABASE_SERVICE_ROLE_KEY?: string;
  BALE_SMART_TOKEN?: string;
  BALE_GROUP_ID?: string;
  INSTAGRAM_REPOST_SECRET?: string;
};

const ACCOUNTS: Record<Account, string> = {
  modiryar_com: "modiryar_com",
  hr_garden: "hr.garden",
};

const AD_PATTERN =
  /تبلیغات|تبلیغاتی|همکاری\s*تبلیغاتی|کد\s*تخفیف|اسپانسر|sponsored|paid partnership|#ad\b|#advertisement\b/i;

function getEnv(): Env {
  return getCloudflareContext().env as Env;
}

function getTehranParts(date: Date) {
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: TZ,
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    hourCycle: "h23",
  }).formatToParts(date);

  const value = (key: string) =>
    parts.find((p) => p.type === key)?.value ?? "";

  return {
    date: `${value("year")}-${value("month")}-${value("day")}`,
    hour: Number(value("hour")),
    minute: Number(value("minute")),
  };
}

/**
 * هر نوبت تا ۱۴ دقیقه بعد از ساعت هدف معتبر است تا
 * اجرای زمان‌بندی‌شده با چند دقیقه تأخیر باعث از دست رفتن نوبت نشود.
 */
function getCurrentSlot(date: Date): {
  account: Account;
  key: string;
} | null {
  const p = getTehranParts(date);
  const slots: Array<{ hour: number; account: Account }> = [
    { hour: 14, account: "modiryar_com" },
    { hour: 15, account: "modiryar_com" },
    { hour: 16, account: "hr_garden" },
    { hour: 17, account: "modiryar_com" },
    { hour: 18, account: "modiryar_com" },
    { hour: 19, account: "hr_garden" },
    { hour: 20, account: "modiryar_com" },
    { hour: 21, account: "modiryar_com" },
    { hour: 22, account: "hr_garden" },
  ];

  const slot = slots.find(
  (s) => s.hour === p.hour && p.minute >= 15 && p.minute < 30,
);

  if (!slot) return null;

  return {
    account: slot.account,
    key: `${p.date}-${String(slot.hour).padStart(2, "0")}:15`,
  };
}

function getStateKey(account: Account) {
  return `instagram_repost_${account}_state_v1`;
}

async function supabase(
  env: Env,
  path: string,
  init: RequestInit = {},
) {
  const url = env.NEXT_PUBLIC_SUPABASE_URL?.replace(/\/+$/, "");
  const key = env.SUPABASE_SERVICE_ROLE_KEY;

  if (!url || !key) {
    throw new Error("تنظیمات Supabase ناقص است.");
  }

  return fetch(`${url}/rest/v1/${path}`, {
    ...init,
    headers: {
      apikey: key,
      Authorization: `Bearer ${key}`,
      "Content-Type": "application/json",
      ...(init.headers ?? {}),
    },
    signal: AbortSignal.timeout(15000),
  });
}

async function readState(
  env: Env,
  account: Account,
): Promise<AccountState> {
  const key = getStateKey(account);
  const res = await supabase(
    env,
    `settings?key=eq.${encodeURIComponent(key)}&select=value&limit=1`,
  );

  if (!res.ok) {
    throw new Error(`خواندن وضعیت از Supabase ناموفق بود: ${res.status}`);
  }

  const rows = (await res.json()) as Array<{ value: unknown }>;
  if (!rows.length) {
    return { version: 1, seen: [], queue: [], sentSlots: [] };
  }

  let value = rows[0].value;
  if (typeof value === "string") value = JSON.parse(value);

  if (
    !value ||
    typeof value !== "object" ||
    (value as AccountState).version !== 1 ||
    !Array.isArray((value as AccountState).seen) ||
    !Array.isArray((value as AccountState).queue) ||
    !Array.isArray((value as AccountState).sentSlots)
  ) {
    throw new Error(`وضعیت ذخیره‌شده ${account} معتبر نیست؛ بازنویسی نشد.`);
  }

  return value as AccountState;
}

async function saveState(
  env: Env,
  account: Account,
  state: AccountState,
) {
  const res = await supabase(env, "settings?on_conflict=key", {
    method: "POST",
    headers: {
      Prefer: "resolution=merge-duplicates,return=minimal",
    },
    body: JSON.stringify({
      key: getStateKey(account),
      value: state,
    }),
  });

  if (!res.ok) {
    throw new Error(`ذخیره وضعیت ناموفق بود: ${res.status}`);
  }
}

function isRecord(value: unknown): value is Record<string, any> {
  return !!value && typeof value === "object" && !Array.isArray(value);
}

function captionOf(node: Record<string, any>): string {
  const candidates = [
    node.caption?.text,
    node.edge_media_to_caption?.edges?.[0]?.node?.text,
    node.caption,
  ];

  return candidates.find((x) => typeof x === "string")?.trim() ?? "";
}

function collectNodes(root: unknown): Record<string, any>[] {
  const found: Record<string, any>[] = [];
  const visited = new Set<object>();

  function walk(value: unknown, depth: number) {
    if (depth > 30 || !value || typeof value !== "object") return;
    if (visited.has(value as object)) return;
    visited.add(value as object);

    if (Array.isArray(value)) {
      for (const item of value) walk(item, depth + 1);
      return;
    }

    const obj = value as Record<string, any>;

    if (
      typeof obj.shortcode === "string" &&
      (typeof obj.display_url === "string" ||
        typeof obj.video_url === "string" ||
        Array.isArray(obj.edge_sidecar_to_children?.edges))
    ) {
      found.push(obj);
    }

    for (const child of Object.values(obj)) {
      walk(child, depth + 1);
    }
  }

  walk(root, 0);
  return found;
}

function mediaOf(node: Record<string, any>) {
  const children = node.edge_sidecar_to_children?.edges;
  const nodes = Array.isArray(children)
    ? children.map((edge: any) => edge?.node).filter(isRecord)
    : [node];

  return nodes
    .map((item: Record<string, any>) => {
      const video = item.is_video === true;
      const url = video
        ? item.video_url
        : item.display_url ?? item.thumbnail_src;

      if (typeof url !== "string" || !/^https:\/\//i.test(url)) {
        return null;
      }

      return { url, video };
    })
    .filter(
      (item: { url: string; video: boolean } | null): item is {
        url: string;
        video: boolean;
      } => item !== null,
    );
}

async function fetchPublicPosts(account: Account): Promise<MediaPost[]> {
  const username = ACCOUNTS[account];
  const response = await fetch(`https://www.instagram.com/${username}/`, {
    headers: {
      "User-Agent":
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 Chrome/131.0.0.0 Safari/537.36",
      Accept: "text/html,application/xhtml+xml",
      "Accept-Language": "en-US,en;q=0.9",
    },
    cache: "no-store",
    signal: AbortSignal.timeout(20000),
  });

  if (!response.ok) {
    throw new Error(
      `اینستاگرام برای @${username} پاسخ HTTP ${response.status} داد.`,
    );
  }

  const html = await response.text();

  if (/login_required|Please wait a few minutes|challenge_required/i.test(html)) {
    throw new Error(`اینستاگرام دسترسی عمومی @${username} را محدود کرده است.`);
  }

  const jsonCandidates: unknown[] = [];
  const scriptRegex =
    /<script\b[^>]*type=["']application\/json["'][^>]*>([\s\S]*?)<\/script>/gi;

  for (const match of html.matchAll(scriptRegex)) {
    try {
      jsonCandidates.push(JSON.parse(match[1]));
    } catch {
      // اسکریپت غیر JSON نادیده گرفته می‌شود.
    }
  }

  // بعضی نسخه‌های صفحه، داده‌ها را در اسکریپت معمولی قرار می‌دهند.
  for (const marker of ["window._sharedData =", "window.__additionalDataLoaded("]) {
    const start = html.indexOf(marker);
    if (start < 0) continue;

    const jsonStart = html.indexOf("{", start);
    if (jsonStart < 0) continue;

    let depth = 0;
    let inString = false;
    let escaped = false;

    for (let i = jsonStart; i < html.length; i++) {
      const ch = html[i];

      if (inString) {
        if (escaped) escaped = false;
        else if (ch === "\\") escaped = true;
        else if (ch === '"') inString = false;
        continue;
      }

      if (ch === '"') inString = true;
      else if (ch === "{") depth++;
      else if (ch === "}") {
        depth--;
        if (depth === 0) {
          try {
            jsonCandidates.push(JSON.parse(html.slice(jsonStart, i + 1)));
          } catch {
            // قالب صفحه قابل‌تجزیه نبود.
          }
          break;
        }
      }
    }
  }

  const byId = new Map<string, MediaPost>();

  for (const root of jsonCandidates) {
    for (const node of collectNodes(root)) {
      const id = String(node.id ?? node.pk ?? node.shortcode);
      const caption = captionOf(node);

      // فیلتر احتیاطی تبلیغات؛ تشخیص کامل تبلیغ ممکن نیست.
      if (node.is_ad === true || node.is_paid_partnership === true) continue;
      if (AD_PATTERN.test(caption)) continue;

      const media = mediaOf(node);
      if (!media.length) continue;

      byId.set(id, {
        id,
        timestamp: Number(node.taken_at_timestamp ?? node.taken_at ?? 0),
        caption,
        media,
      });
    }
  }

  if (!byId.size) {
    throw new Error(
      `هیچ پست رسانه‌داری از @${username} استخراج نشد؛ ممکن است قالب اینستاگرام تغییر کرده یا دسترسی محدود شده باشد.`,
    );
  }

  return [...byId.values()].sort((a, b) => a.timestamp - b.timestamp);
}

async function sendSingleMedia(
  env: Env,
  item: { url: string; video: boolean },
  caption: string,
) {
  const token = env.BALE_SMART_TOKEN;
  const chatId = env.BALE_GROUP_ID;

  if (!token || !chatId) {
    throw new Error("BALE_SMART_TOKEN یا BALE_GROUP_ID تنظیم نشده است.");
  }

  // رسانه را خود سرور دریافت می‌کند و به بله آپلود می‌کند.
  const mediaResponse = await fetch(item.url, {
    headers: {
      "User-Agent": "Mozilla/5.0",
      Referer: "https://www.instagram.com/",
    },
    signal: AbortSignal.timeout(25000),
  });

  if (!mediaResponse.ok) {
    throw new Error(`دریافت رسانه از اینستاگرام ناموفق بود: ${mediaResponse.status}`);
  }

  const blob = await mediaResponse.blob();
  if (!blob.size) throw new Error("رسانه دریافتی خالی است.");

  const form = new FormData();
  form.set("chat_id", chatId);
  if (caption) form.set("caption", caption.slice(0, 1024));

  const field = item.video ? "video" : "photo";
  const filename = item.video ? "instagram.mp4" : "instagram.jpg";
  form.set(field, new File([blob], filename, { type: blob.type || (item.video ? "video/mp4" : "image/jpeg") }));

  const method = item.video ? "sendVideo" : "sendPhoto";
  const res = await fetch(`https://tapi.bale.ai/bot${token}/${method}`, {
    method: "POST",
    body: form,
    signal: AbortSignal.timeout(40000),
  });

  const result = (await res.json().catch(() => null)) as
    | { ok?: boolean; description?: string }
    | null;

  if (!res.ok || result?.ok !== true) {
    throw new Error(`ارسال رسانه به بله ناموفق بود: ${result?.description ?? res.status}`);
  }
}

export async function GET(request: Request): Promise<Response> {
  try {
    const env = getEnv();

    // اختیاری اما توصیه‌شده: جلوگیری از اجرای عمومی توسط افراد دیگر.
    if (env.INSTAGRAM_REPOST_SECRET) {
      const supplied = new URL(request.url).searchParams.get("key");
      if (supplied !== env.INSTAGRAM_REPOST_SECRET) {
        return Response.json({ ok: false, error: "Unauthorized" }, { status: 401 });
      }
    }

    const slot = getCurrentSlot(new Date());
    if (!slot) {
      return Response.json({ ok: true, skipped: true, reason: "خارج از زمان نوبت‌ها" });
    }

    const state = await readState(env, slot.account);
    if (state.sentSlots.includes(slot.key)) {
      return Response.json({ ok: true, skipped: true, reason: "این نوبت قبلاً انجام شده است" });
    }

    const fetched = await fetchPublicPosts(slot.account);
    const seen = new Set(state.seen);
    const queued = new Set(state.queue.map((post) => post.id));

    const discovered = fetched.filter(
      (post) => !seen.has(post.id) && !queued.has(post.id),
    );

    state.queue = [...state.queue, ...discovered].sort(
      (a, b) => a.timestamp - b.timestamp,
    );

    if (!state.queue.length) {
      await saveState(env, slot.account, state);
      return Response.json({
        ok: true,
        sent: false,
        reason: "پست رسانه‌دارِ واجد شرایط و ارسال‌نشده پیدا نشد",
      });
    }

    const post = state.queue[0];

    // نسخه پایه: رسانه‌های آلبوم جداگانه فرستاده می‌شوند.
    // برای کاهش خطر ارسال ناقص، آلبوم چندرسانه‌ای در این نسخه ارسال نمی‌شود.
    if (post.media.length !== 1) {
      return Response.json({
        ok: false,
        error: "این پست آلبوم چندرسانه‌ای است؛ برای جلوگیری از ارسال ناقص، فعلاً ارسال نشد.",
        postId: post.id,
      }, { status: 422 });
    }

    await sendSingleMedia(env, post.media[0], post.caption);

    state.seen = [...new Set([...state.seen, post.id])].slice(-MAX_SEEN);
    state.queue = state.queue.filter((item) => item.id !== post.id);
    state.sentSlots = [...new Set([...state.sentSlots, slot.key])].slice(-90);
    await saveState(env, slot.account, state);

    return Response.json({
      ok: true,
      sent: true,
      account: slot.account,
      postId: post.id,
      slot: slot.key,
      captionIncluded: Boolean(post.caption),
      linkAddedToCaption: false,
    });
  } catch (error) {
    return Response.json({
      ok: false,
      error: error instanceof Error ? error.message : String(error),
    }, { status: 500 });
  }
}
