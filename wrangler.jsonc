{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sedaye-smart",
  "main": "worker.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "45 4 * * *",
      "0 19 * * *"
    ]
  }
}
